<Window
    x:Class="ProjectFileHub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjectFileHub.App"
    xmlns:viewModels="using:ProjectFileHub.App.ViewModels">

    <Grid x:Name="RootLayout"
          Background="{StaticResource HubCanvasBrush}"
          Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="{StaticResource HubCanvasBrush}"
              BorderBrush="{StaticResource HubBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="14,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,18,0">
                <Border Width="24" Height="24" CornerRadius="7" BorderBrush="{StaticResource HubAccentBrush}" BorderThickness="1">
                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource HubAccentStrongBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                </Border>
                <TextBlock Text="Project File Hub" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" Style="{StaticResource HubInlineLabelStyle}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Margin="0,0,6,0"
                    Style="{StaticResource HubToolbarButtonStyle}"
                    Click="OnManageProjectsClicked"
                    ToolTipService.ToolTip="管理已添加的项目">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource HubAccentBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                    <TextBlock Text="项目管理" FontSize="12" Style="{StaticResource HubInlineLabelStyle}" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="7"
                        VerticalAlignment="Center">
                <ComboBox x:Name="ProjectPicker"
                          MinWidth="132"
                          MaxDropDownHeight="320"
                          HorizontalAlignment="Left"
                          Style="{StaticResource HubCompactComboBoxStyle}"
                          PlaceholderText="选择项目"
                          DisplayMemberPath="Name"
                          SelectionChanged="OnProjectSelectionChanged"
                          VerticalAlignment="Center" />
                <Border Padding="7,2"
                        CornerRadius="8"
                        Background="{StaticResource HubRaisedBrush}"
                        BorderBrush="{StaticResource HubBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ProjectRegistryCountText"
                               Text="0 个"
                               FontSize="11"
                               Foreground="{StaticResource HubTextMutedBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <TextBlock x:Name="BreadcrumbText"
                       Grid.Column="3"
                       Margin="12,0,20,0"
                       Text="尚未打开项目"
                       Foreground="{StaticResource HubTextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <TextBox x:Name="SearchBox"
                     Grid.Column="4"
                     Width="260"
                     Height="36"
                     PlaceholderText="搜索当前文件夹"
                     VerticalAlignment="Center"
                     IsEnabled="False"
                     Visibility="Collapsed" />

            <Button Grid.Column="5"
                    Margin="10,0,0,0"
                    Style="{StaticResource HubPrimaryButtonStyle}"
                    Click="OnAddProjectClicked">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE710;" FontSize="13" Style="{StaticResource HubInlineGlyphStyle}" />
                    <TextBlock Text="添加项目" Style="{StaticResource HubInlineLabelStyle}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="6"
                    Margin="6,0,0,0"
                    Style="{StaticResource HubIconButtonStyle}"
                    Click="OnOpenSettingsClicked"
                    ToolTipService.ToolTip="设置">
                <FontIcon Glyph="&#xE713;" FontSize="15" Style="{StaticResource HubInlineGlyphStyle}" />
            </Button>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="232" />
                <ColumnDefinition x:Name="FilterRailColumn" Width="78" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="292" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource HubPanelBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="项目" Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource HubTextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" />
                <TreeView x:Name="ProjectTree"
                          Grid.Row="1"
                          Margin="6,0"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource HubTreeViewItemStyle}"
                          Expanding="OnTreeExpanding"
                          ItemInvoked="OnTreeItemInvoked">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinWidth="150"
                                  MinHeight="32"
                                  Padding="0"
                                  Background="Transparent"
                                  AllowDrop="True"
                                  DoubleTapped="OnTreeFolderDoubleTapped"
                                  DragOver="OnTreeFolderDragOver"
                                  DragLeave="OnFolderDragLeave"
                                  Drop="OnTreeFolderDrop">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="打开" Tag="{Binding Content.FullPath}" Click="OnTreeMenuOpenClicked" />
                                        <MenuFlyoutItem Text="在资源管理器中打开" Tag="{Binding Content.FullPath}" Click="OnTreeMenuOpenInExplorerClicked" />
                                        <MenuFlyoutItem Text="重命名" Tag="{Binding Content.FullPath}" Click="OnTreeMenuRenameClicked" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="新建文件夹" Tag="{Binding Content.FullPath}" Click="OnTreeMenuNewFolderClicked" />
                                        <MenuFlyoutItem Text="复制路径" Tag="{Binding Content.FullPath}" Click="OnTreeMenuCopyPathClicked" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="移到回收站" Tag="{Binding Content.FullPath}" Foreground="{StaticResource HubDangerBrush}" Click="OnTreeMenuRecycleClicked" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid Height="32" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource HubAccentBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                                    <TextBlock Grid.Column="1" Margin="2,0,0,0" Text="{Binding Content.Name}" Foreground="{StaticResource HubTextSecondaryBrush}" TextTrimming="CharacterEllipsis" Style="{StaticResource HubInlineLabelStyle}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <Grid x:Name="TypeFilterRail" Grid.Column="1" Background="{StaticResource HubCanvasBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="0,0,1,0" Padding="0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Width="58" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="AllTypeFilter" Tag="All" AutomationProperties.Name="全部文件" Style="{StaticResource HubRailHitButtonStyle}" Click="OnTypeFilterClicked" />
                    <Border x:Name="AllFilterSelection" Background="{StaticResource HubSelectedBrush}" CornerRadius="8" IsHitTestVisible="False">
                        <Rectangle Width="3" Height="24" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource HubAccentStrongBrush}" RadiusX="2" RadiusY="2" />
                    </Border>
                    <StackPanel Width="40" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <FontIcon x:Name="AllFilterIcon" Glyph="&#xE8A9;" FontSize="16" Foreground="{StaticResource HubAccentStrongBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                        <TextBlock x:Name="AllFilterLabel" Text="全部" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource HubAccentStrongBrush}" Style="{StaticResource HubInlineLabelStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Width="58" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ImageTypeFilter" Tag="Image" AutomationProperties.Name="图片文件" Style="{StaticResource HubRailHitButtonStyle}" Click="OnTypeFilterClicked" />
                    <Border x:Name="ImageFilterSelection" Background="{StaticResource HubSelectedBrush}" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle Width="3" Height="24" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource HubAccentStrongBrush}" RadiusX="2" RadiusY="2" />
                    </Border>
                    <StackPanel Width="40" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <FontIcon x:Name="ImageFilterIcon" Glyph="&#xEB9F;" FontSize="16" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                        <TextBlock x:Name="ImageFilterLabel" Text="图片" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineLabelStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Width="58" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="VideoTypeFilter" Tag="Video" AutomationProperties.Name="视频文件" Style="{StaticResource HubRailHitButtonStyle}" Click="OnTypeFilterClicked" />
                    <Border x:Name="VideoFilterSelection" Background="{StaticResource HubSelectedBrush}" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle Width="3" Height="24" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource HubAccentStrongBrush}" RadiusX="2" RadiusY="2" />
                    </Border>
                    <StackPanel Width="40" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <FontIcon x:Name="VideoFilterIcon" Glyph="&#xE714;" FontSize="16" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                        <TextBlock x:Name="VideoFilterLabel" Text="视频" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineLabelStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3" Width="58" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="AudioTypeFilter" Tag="Audio" AutomationProperties.Name="音频文件" Style="{StaticResource HubRailHitButtonStyle}" Click="OnTypeFilterClicked" />
                    <Border x:Name="AudioFilterSelection" Background="{StaticResource HubSelectedBrush}" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle Width="3" Height="24" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource HubAccentStrongBrush}" RadiusX="2" RadiusY="2" />
                    </Border>
                    <StackPanel Width="40" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <FontIcon x:Name="AudioFilterIcon" Glyph="&#xE8D6;" FontSize="16" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                        <TextBlock x:Name="AudioFilterLabel" Text="音频" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineLabelStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="4" Width="58" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="DocumentTypeFilter" Tag="Document" AutomationProperties.Name="文档文件" Style="{StaticResource HubRailHitButtonStyle}" Click="OnTypeFilterClicked" />
                    <Border x:Name="DocumentFilterSelection" Background="{StaticResource HubSelectedBrush}" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle Width="3" Height="24" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource HubAccentStrongBrush}" RadiusX="2" RadiusY="2" />
                    </Border>
                    <StackPanel Width="40" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <FontIcon x:Name="DocumentFilterIcon" Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                        <TextBlock x:Name="DocumentFilterLabel" Text="文档" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineLabelStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="5" Width="58" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="CodeTypeFilter" Tag="Code" AutomationProperties.Name="代码文件" Style="{StaticResource HubRailHitButtonStyle}" Click="OnTypeFilterClicked" />
                    <Border x:Name="CodeFilterSelection" Background="{StaticResource HubSelectedBrush}" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle Width="3" Height="24" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource HubAccentStrongBrush}" RadiusX="2" RadiusY="2" />
                    </Border>
                    <StackPanel Width="40" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <FontIcon x:Name="CodeFilterIcon" Glyph="&#xE943;" FontSize="16" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                        <TextBlock x:Name="CodeFilterLabel" Text="代码" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubInlineLabelStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="MainFilePanel" Grid.Column="2" Background="{StaticResource HubCanvasBrush}" Padding="18,14,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="FolderTitle" Text="欢迎" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" />
                    <TextBlock x:Name="FolderSubtitle" Text="添加一个本机项目开始管理" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource HubTextMutedBrush}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ItemCountText" Text="0 个项目" Foreground="{StaticResource HubTextSecondaryBrush}" VerticalAlignment="Center" />
                    <Button x:Name="ActiveFilterButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Height="30"
                            Padding="10,0"
                            Visibility="Collapsed"
                            Style="{StaticResource HubPrimaryButtonStyle}"
                            Click="OnClearTypeFilterClicked"
                            ToolTipService.ToolTip="取消当前筛选">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveFilterText" Text="图片" FontSize="11" Style="{StaticResource HubInlineLabelStyle}" />
                            <FontIcon Glyph="&#xE711;" FontSize="10" Style="{StaticResource HubInlineGlyphStyle}" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="SortPicker" Grid.Column="3" Width="126" VerticalAlignment="Center" Style="{StaticResource HubCompactComboBoxStyle}" SelectedIndex="0" SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="名称" Tag="Name" />
                        <ComboBoxItem Content="修改时间" Tag="ModifiedAt" />
                        <ComboBoxItem Content="创建时间" Tag="CreatedAt" />
                        <ComboBoxItem Content="类型" Tag="Type" />
                        <ComboBoxItem Content="大小" Tag="Size" />
                    </ComboBox>
                    <Button x:Name="SortDirectionButton" Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource HubIconButtonStyle}" Click="OnSortDirectionClicked" ToolTipService.ToolTip="切换排序方向">
                        <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74A;" FontSize="14" Style="{StaticResource HubInlineGlyphStyle}" />
                    </Button>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="GridModeButton" Style="{StaticResource HubIconButtonStyle}" Click="OnGridModeClicked" ToolTipService.ToolTip="网格视图">
                            <FontIcon Glyph="&#xF0E2;" FontSize="15" Style="{StaticResource HubInlineGlyphStyle}" />
                        </Button>
                        <Button x:Name="ListModeButton" Style="{StaticResource HubIconButtonStyle}" Click="OnListModeClicked" ToolTipService.ToolTip="列表视图">
                            <FontIcon Glyph="&#xEA37;" FontSize="15" Style="{StaticResource HubInlineGlyphStyle}" />
                        </Button>
                        <Button x:Name="MultiSelectButton" Margin="6,0,0,0" Style="{StaticResource HubToolbarButtonStyle}" Click="OnToggleMultiSelectClicked" ToolTipService.ToolTip="进入多选模式">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon x:Name="MultiSelectIcon" Glyph="&#xE762;" FontSize="14" Style="{StaticResource HubInlineGlyphStyle}" />
                                <TextBlock x:Name="MultiSelectLabel" Text="多选" FontSize="11" Style="{StaticResource HubInlineLabelStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="SelectionActionBar"
                        Grid.Row="2"
                        Height="44"
                        Margin="0,1,0,9"
                        Padding="12,0"
                        Background="{StaticResource HubSelectedBrush}"
                        BorderBrush="{StaticResource HubAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE762;" FontSize="14" Foreground="{StaticResource HubAccentStrongBrush}" Style="{StaticResource HubInlineGlyphStyle}" />
                            <TextBlock x:Name="MultiSelectionCountText" Text="已选择 0 项" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" Style="{StaticResource HubInlineLabelStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Button Height="32" Padding="10,0" Content="全选" Style="{StaticResource HubToolbarButtonStyle}" Click="OnSelectAllClicked" />
                            <Button x:Name="CopySelectionButton" Height="32" Padding="10,0" Style="{StaticResource HubToolbarButtonStyle}" Click="OnCopySelectionClicked" ToolTipService.ToolTip="复制文件，可在其他文件夹粘贴（Ctrl+C）">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" Style="{StaticResource HubInlineGlyphStyle}" /><TextBlock Text="复制" FontSize="11" Style="{StaticResource HubInlineLabelStyle}" /></StackPanel>
                            </Button>
                            <Button x:Name="CopySelectionToButton" Height="32" Padding="10,0" Content="复制到…" Style="{StaticResource HubToolbarButtonStyle}" Click="OnCopySelectionToClicked" />
                            <Button x:Name="MoveSelectionToButton" Height="32" Padding="10,0" Content="移动到…" Style="{StaticResource HubToolbarButtonStyle}" Click="OnMoveSelectionToClicked" />
                            <Button x:Name="RecycleSelectionButton" Height="32" Padding="10,0" Foreground="{StaticResource HubDangerBrush}" Style="{StaticResource HubToolbarButtonStyle}" Click="OnRecycleSelectionClicked">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" Style="{StaticResource HubInlineGlyphStyle}" /><TextBlock Text="回收站" FontSize="11" Style="{StaticResource HubInlineLabelStyle}" /></StackPanel>
                            </Button>
                            <Button Height="32" Padding="10,0" Content="清除" Style="{StaticResource HubToolbarButtonStyle}" Click="OnClearSelectionClicked" />
                            <Button Height="32" Padding="10,0" Content="完成" Style="{StaticResource HubPrimaryButtonStyle}" Click="OnExitMultiSelectClicked" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="FileSurface"
                      Grid.Row="3"
                      Background="Transparent"
                      AllowDrop="True"
                      DragOver="OnFileSurfaceDragOver"
                      DragLeave="OnFolderDragLeave"
                      Drop="OnFileSurfaceDrop">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="新建文件夹" Click="OnBackgroundMenuNewFolderClicked" />
                            <MenuFlyoutItem Text="粘贴" Click="OnBackgroundMenuPasteClicked" />
                            <MenuFlyoutItem Text="刷新" Click="OnBackgroundMenuRefreshClicked" />
                            <MenuFlyoutItem Text="在资源管理器中打开当前文件夹" Click="OnBackgroundMenuOpenInExplorerClicked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="全选" Click="OnSelectAllClicked" />
                            <MenuFlyoutItem Text="复制当前文件夹路径" Click="OnBackgroundMenuCopyPathClicked" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <GridView x:Name="FileGrid"
                              ItemsSource="{x:Bind Items}"
                              SelectionMode="Extended"
                              IsMultiSelectCheckBoxEnabled="False"
                              CanDragItems="True"
                              ItemContainerStyle="{StaticResource HubGridItemStyle}"
                              SelectionChanged="OnFileSelectionChanged"
                              ContainerContentChanging="OnFileContainerContentChanging"
                              DragItemsStarting="OnFileDragItemsStarting"
                              DragItemsCompleted="OnFileDragItemsCompleted"
                              DoubleTapped="OnFileViewDoubleTapped">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="210" ItemHeight="198" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ExplorerItemViewModel">
                                <Border Width="198"
                                        Height="186"
                                        Background="{StaticResource HubRaisedBrush}"
                                        BorderBrush="{StaticResource HubBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        AllowDrop="{x:Bind IsDirectory}"
                                        RightTapped="OnItemRightTapped"
                                        DragOver="OnContentFolderDragOver"
                                        DragLeave="OnFolderDragLeave"
                                        Drop="OnContentFolderDrop"
                                        ToolTipService.ToolTip="{x:Bind Name}"
                                        AutomationProperties.Name="{x:Bind Name}">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="打开" Tag="{x:Bind FullPath}" Click="OnItemMenuOpenClicked" />
                                            <MenuFlyoutItem Text="快速预览" Tag="{x:Bind FullPath}" Click="OnItemMenuPreviewClicked" />
                                            <MenuFlyoutItem Text="在资源管理器中打开" Tag="{x:Bind FullPath}" Click="OnItemMenuOpenInExplorerClicked" />
                                            <MenuFlyoutItem Text="重命名" Tag="{x:Bind FullPath}" Click="OnItemMenuRenameClicked" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="复制" Tag="{x:Bind FullPath}" Click="OnItemMenuCopyClicked" />
                                            <MenuFlyoutItem Text="复制到…" Tag="{x:Bind FullPath}" Click="OnItemMenuCopyToClicked" />
                                            <MenuFlyoutItem Text="移动到…" Tag="{x:Bind FullPath}" Click="OnItemMenuMoveToClicked" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="复制路径" Tag="{x:Bind FullPath}" Click="OnItemMenuCopyPathClicked" />
                                            <MenuFlyoutItem Text="移到回收站" Tag="{x:Bind FullPath}" Foreground="{StaticResource HubDangerBrush}" Click="OnItemMenuRecycleClicked" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="116" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource HubCanvasBrush}" CornerRadius="7,7,0,0">
                                            <Grid>
                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" Stretch="UniformToFill" />
                                                <Grid Width="104"
                                                      Height="90"
                                                      Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                                                      AutomationProperties.Name="{x:Bind IconDescription}"
                                                      IsHitTestVisible="False">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}"
                                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                              FontSize="64"
                                                              Foreground="{x:Bind IconBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource HubFileTypeBadgeStyle}"
                                                            Margin="0,0,2,2"
                                                            BorderBrush="{x:Bind IconBrush}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Visibility="{x:Bind IconBadgeVisibility}">
                                                        <TextBlock Text="{x:Bind IconBadgeText}"
                                                                   Foreground="{x:Bind IconBrush}"
                                                                   Style="{StaticResource HubFileTypeBadgeTextStyle}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" Padding="9,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{x:Bind Name}"
                                                           Visibility="{x:Bind NameVisibility, Mode=OneWay}"
                                                           Height="36"
                                                           VerticalAlignment="Top"
                                                           FontSize="12"
                                                           LineHeight="17"
                                                           TextLineBounds="Full"
                                                           MaxLines="2"
                                                           Foreground="{StaticResource HubTextBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Name}" />
                                                <TextBox x:Name="RenameBox"
                                                         Text="{x:Bind RenameText, Mode=TwoWay}"
                                                         Visibility="{x:Bind RenameVisibility, Mode=OneWay}"
                                                         Tag="{x:Bind FullPath}"
                                                         Height="28"
                                                         Padding="6,2"
                                                         FontSize="12"
                                                         BorderBrush="{StaticResource HubAccentBrush}"
                                                         KeyDown="OnRenameBoxKeyDown"
                                                         LostFocus="OnRenameBoxLostFocus" />
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Text="{x:Bind LocationText}"
                                                       Visibility="{x:Bind LocationVisibility}"
                                                       Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource HubTextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2"
                                                       Text="{x:Bind RenameError, Mode=OneWay}"
                                                       Visibility="{x:Bind RenameErrorVisibility, Mode=OneWay}"
                                                       Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource HubDangerBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid Grid.Row="3" Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind ModifiedText}" FontSize="10" Foreground="{StaticResource HubTextMutedBrush}" />
                                                <TextBlock Text="{x:Bind SizeText}" FontSize="10" Foreground="{StaticResource HubTextMutedBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                        <Border Grid.RowSpan="2"
                                                BorderBrush="{StaticResource HubAccentStrongBrush}"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                Visibility="{x:Bind SelectionVisibility, Mode=OneWay}"
                                                IsHitTestVisible="False" />
                                        <Border Width="22"
                                                Height="22"
                                                Margin="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource HubAccentStrongBrush}"
                                                CornerRadius="11"
                                                Visibility="{x:Bind SelectionVisibility, Mode=OneWay}"
                                                IsHitTestVisible="False">
                                            <FontIcon Glyph="&#xE73E;"
                                                      FontSize="11"
                                                      Foreground="{StaticResource HubCanvasBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <ListView x:Name="FileList"
                              Visibility="Collapsed"
                              ItemsSource="{x:Bind Items}"
                              SelectionMode="Extended"
                              CanDragItems="True"
                              ItemContainerStyle="{StaticResource HubListItemStyle}"
                              SelectionChanged="OnFileSelectionChanged"
                              ContainerContentChanging="OnFileContainerContentChanging"
                              DragItemsStarting="OnFileDragItemsStarting"
                              DragItemsCompleted="OnFileDragItemsCompleted"
                              DoubleTapped="OnFileViewDoubleTapped">
                        <ListView.Header>
                            <Grid Height="34" Padding="8,0" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称" Foreground="{StaticResource HubTextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="类型" Foreground="{StaticResource HubTextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="修改时间" Foreground="{StaticResource HubTextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="大小" Foreground="{StaticResource HubTextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ExplorerItemViewModel">
                                    <Grid Background="Transparent"
                                      MinHeight="34"
                                      AllowDrop="{x:Bind IsDirectory}"
                                      RightTapped="OnItemRightTapped"
                                      DragOver="OnContentFolderDragOver"
                                      DragLeave="OnFolderDragLeave"
                                      Drop="OnContentFolderDrop"
                                      ToolTipService.ToolTip="{x:Bind Name}"
                                      AutomationProperties.Name="{x:Bind Name}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="打开" Tag="{x:Bind FullPath}" Click="OnItemMenuOpenClicked" />
                                            <MenuFlyoutItem Text="快速预览" Tag="{x:Bind FullPath}" Click="OnItemMenuPreviewClicked" />
                                            <MenuFlyoutItem Text="在资源管理器中打开" Tag="{x:Bind FullPath}" Click="OnItemMenuOpenInExplorerClicked" />
                                            <MenuFlyoutItem Text="重命名" Tag="{x:Bind FullPath}" Click="OnItemMenuRenameClicked" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="复制" Tag="{x:Bind FullPath}" Click="OnItemMenuCopyClicked" />
                                            <MenuFlyoutItem Text="复制到…" Tag="{x:Bind FullPath}" Click="OnItemMenuCopyToClicked" />
                                            <MenuFlyoutItem Text="移动到…" Tag="{x:Bind FullPath}" Click="OnItemMenuMoveToClicked" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="复制路径" Tag="{x:Bind FullPath}" Click="OnItemMenuCopyPathClicked" />
                                            <MenuFlyoutItem Text="移到回收站" Tag="{x:Bind FullPath}" Foreground="{StaticResource HubDangerBrush}" Click="OnItemMenuRecycleClicked" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="30" Height="30" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                   Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}"
                                                   Width="28"
                                                   Height="28"
                                                   Stretch="UniformToFill" />
                                            <Grid Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind IconDescription}">
                                                <FontIcon Glyph="{x:Bind IconGlyph}"
                                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                          FontSize="24"
                                                          Foreground="{x:Bind IconBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{x:Bind Name}"
                                                       Visibility="{x:Bind NameVisibility, Mode=OneWay}"
                                                       Foreground="{StaticResource HubTextBrush}"
                                                       Style="{StaticResource HubFileListCellTextStyle}" />
                                            <TextBlock Grid.Row="1" Text="{x:Bind LocationText}" Visibility="{x:Bind LocationVisibility}" FontSize="10" Foreground="{StaticResource HubTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBox x:Name="RenameBox"
                                                     Text="{x:Bind RenameText, Mode=TwoWay}"
                                                     Visibility="{x:Bind RenameVisibility, Mode=OneWay}"
                                                     Tag="{x:Bind FullPath}"
                                                     Height="28"
                                                     Padding="6,2"
                                                     BorderBrush="{StaticResource HubAccentBrush}"
                                                     KeyDown="OnRenameBoxKeyDown"
                                                     LostFocus="OnRenameBoxLostFocus" />
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind RenameError, Mode=OneWay}"
                                                   Visibility="{x:Bind RenameErrorVisibility, Mode=OneWay}"
                                                   Margin="0,27,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource HubDangerBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayType}" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubFileListCellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" Foreground="{StaticResource HubTextSecondaryBrush}" Style="{StaticResource HubFileListCellTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Foreground="{StaticResource HubTextSecondaryBrush}" HorizontalAlignment="Right" Style="{StaticResource HubFileListCellTextStyle}" />
                                    <Border Grid.ColumnSpan="4"
                                            BorderBrush="{StaticResource HubAccentStrongBrush}"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Visibility="{x:Bind SelectionVisibility, Mode=OneWay}"
                                            IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="54" Height="54" CornerRadius="17" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1" Background="{StaticResource HubRaisedBrush}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{StaticResource HubAccentBrush}" />
                        </Border>
                        <TextBlock x:Name="EmptyStateTitle" Text="尚未添加项目" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyStateMessage" Text="只管理你明确添加的项目目录" FontSize="12" Foreground="{StaticResource HubTextMutedBrush}" HorizontalAlignment="Center" />
                        <Button Content="选择项目文件夹" Style="{StaticResource HubPrimaryButtonStyle}" Click="OnAddProjectClicked" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Grid x:Name="FileLoadingOverlay"
                          Background="{StaticResource HubCanvasBrush}"
                          Opacity="0.94"
                          Visibility="Collapsed"
                          Canvas.ZIndex="20">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MinWidth="340"
                                Padding="22,18"
                                Background="{StaticResource HubPanelBrush}"
                                BorderBrush="{StaticResource HubBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <ProgressRing x:Name="FileLoadingRing"
                                              Width="26"
                                              Height="26"
                                              Foreground="{StaticResource HubAccentStrongBrush}"
                                              IsActive="False" />
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="FileLoadingTitle"
                                               Text="正在筛选当前文件夹…"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource HubTextBrush}" />
                                    <TextBlock x:Name="FileLoadingDetail"
                                               Text="正在读取文件列表"
                                               FontSize="11"
                                               Foreground="{StaticResource HubTextMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="InspectorPanel" Grid.Column="3" Background="{StaticResource HubPanelBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1,0,0,0" Padding="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="详细信息" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                <Border Grid.Row="1" Height="154" Background="{StaticResource HubCanvasBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid MinHeight="22">
                        <Image x:Name="InspectorImage" Stretch="UniformToFill" Visibility="Collapsed" />
                        <FontIcon x:Name="InspectorIcon" Glyph="&#xE7C3;" FontSize="38" Foreground="{StaticResource HubTextMutedBrush}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,16,0,0" Spacing="13">
                    <TextBlock x:Name="InspectorName" Text="未选择文件" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="类型" Foreground="{StaticResource HubTextMutedBrush}" Style="{StaticResource HubInlineLabelStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="InspectorType" Grid.Column="1" Text="—" Foreground="{StaticResource HubTextSecondaryBrush}" HorizontalAlignment="Right" Style="{StaticResource HubInlineLabelStyle}" IsTextSelectionEnabled="True" />
                    </Grid>
                    <Grid MinHeight="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="大小" Foreground="{StaticResource HubTextMutedBrush}" Style="{StaticResource HubInlineLabelStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="InspectorSize" Grid.Column="1" Text="—" Foreground="{StaticResource HubTextSecondaryBrush}" HorizontalAlignment="Right" Style="{StaticResource HubInlineLabelStyle}" IsTextSelectionEnabled="True" />
                    </Grid>
                    <Grid MinHeight="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="修改时间" Foreground="{StaticResource HubTextMutedBrush}" Style="{StaticResource HubInlineLabelStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="InspectorModified" Grid.Column="1" Text="—" Foreground="{StaticResource HubTextSecondaryBrush}" HorizontalAlignment="Right" Style="{StaticResource HubInlineLabelStyle}" IsTextSelectionEnabled="True" />
                    </Grid>
                    <TextBlock Text="路径" Foreground="{StaticResource HubTextMutedBrush}" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="InspectorPath" Text="—" Foreground="{StaticResource HubTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
                <StackPanel Grid.Row="3" Spacing="8">
                    <Button Style="{StaticResource HubToolbarButtonStyle}" HorizontalAlignment="Stretch" Click="OnOpenSelectedClicked">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" Style="{StaticResource HubInlineGlyphStyle}" />
                            <TextBlock Text="使用默认应用打开" Style="{StaticResource HubInlineLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HubToolbarButtonStyle}" HorizontalAlignment="Stretch" Click="OnCopyPathClicked">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" Style="{StaticResource HubInlineGlyphStyle}" />
                            <TextBlock Text="复制路径" Style="{StaticResource HubInlineLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HubToolbarButtonStyle}" HorizontalAlignment="Stretch" Foreground="{StaticResource HubDangerBrush}" Click="OnRecycleSelectedClicked">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Style="{StaticResource HubInlineGlyphStyle}" />
                            <TextBlock Text="移到回收站" Style="{StaticResource HubInlineLabelStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="SinglePreviewScrim"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Background="#A600050A"
                    Visibility="Collapsed"
                    Tapped="OnSinglePreviewScrimTapped"
                    Canvas.ZIndex="99" />

            <Border x:Name="PreviewOverlay"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Margin="12"
                    Background="{StaticResource HubCanvasBrush}"
                    BorderBrush="{StaticResource HubBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Visibility="Collapsed"
                    Canvas.ZIndex="100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="54" />
                        <RowDefinition x:Name="PreviewFilmstripRow" Height="142" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <ScrollViewer x:Name="PreviewImageScroll"
                                      Margin="18"
                                      HorizontalContentAlignment="Center"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalContentAlignment="Center"
                                      VerticalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Auto"
                                      ZoomMode="Enabled"
                                      MinZoomFactor="0.5"
                                      MaxZoomFactor="8"
                                      Visibility="Collapsed">
                            <Grid x:Name="PreviewImageCanvas">
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                            </Grid>
                        </ScrollViewer>
                        <MediaPlayerElement x:Name="PreviewMedia"
                                            Margin="18"
                                            AreTransportControlsEnabled="True"
                                            AutoPlay="False"
                                            Visibility="Collapsed" />
                        <ScrollViewer x:Name="PreviewTextScroll"
                                      Margin="28,24"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <TextBlock x:Name="PreviewText"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="13"
                                       Foreground="{StaticResource HubTextSecondaryBrush}"
                                       IsTextSelectionEnabled="True"
                                       LineHeight="21"
                                       TextWrapping="NoWrap" />
                        </ScrollViewer>
                        <Border x:Name="PreviewCodeSurface"
                                Margin="88,24"
                                Background="#FF272822"
                                BorderBrush="#FF49483E"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="16,0"
                                      Background="#FF1E1F1C"
                                      BorderBrush="#FF3E3D32"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="#FFA6E22E" />
                                        <TextBlock Text="Sublime Text 2 · Monokai"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFF8F8F2"
                                                   IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <TextBlock x:Name="PreviewCodeLanguage"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10"
                                               Foreground="#FF75715E"
                                               IsTextSelectionEnabled="True" />
                                </Grid>
                                <ScrollViewer x:Name="PreviewCodeScroll"
                                              Grid.Row="1"
                                              Padding="0,14,18,18"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PreviewCodeLineNumbers"
                                                   Padding="16,0,13,0"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="13"
                                                   Foreground="#FF75715E"
                                                   IsTextSelectionEnabled="False"
                                                   LineHeight="21"
                                                   TextAlignment="Right" />
                                        <Border Grid.Column="1"
                                                Padding="14,0,0,0"
                                                BorderBrush="#FF3E3D32"
                                                BorderThickness="1,0,0,0">
                                            <RichTextBlock x:Name="PreviewCodeText"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="13"
                                                           Foreground="#FFF8F8F2"
                                                           IsTextSelectionEnabled="True"
                                                           LineHeight="21"
                                                           TextWrapping="NoWrap" />
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="PreviewMarkdownScroll"
                                      Margin="24,20"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <Border x:Name="PreviewMarkdownPage"
                                    MaxWidth="960"
                                    MinWidth="560"
                                    Padding="48,38"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource HubPanelBrush}"
                                    BorderBrush="{StaticResource HubBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel x:Name="PreviewMarkdownDocument" Spacing="4" />
                            </Border>
                        </ScrollViewer>
                        <StackPanel x:Name="PreviewFallback" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon x:Name="PreviewFallbackIcon" Glyph="&#xE7C3;" FontSize="48" Foreground="{StaticResource HubTextMutedBrush}" />
                            <TextBlock x:Name="PreviewFallbackText" Text="当前类型暂不支持内置预览" Foreground="{StaticResource HubTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <Button x:Name="PreviewPreviousButton"
                                Width="48"
                                Height="48"
                                Margin="18"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Style="{StaticResource HubToolbarButtonStyle}"
                                Click="OnPreviewPreviousClicked"
                                ToolTipService.ToolTip="上一个文件"
                                AutomationProperties.Name="预览上一个文件">
                            <FontIcon Glyph="&#xE76B;" FontSize="20" Style="{StaticResource HubInlineGlyphStyle}" />
                        </Button>
                        <Button x:Name="PreviewNextButton"
                                Width="48"
                                Height="48"
                                Margin="18"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Style="{StaticResource HubToolbarButtonStyle}"
                                Click="OnPreviewNextClicked"
                                ToolTipService.ToolTip="下一个文件"
                                AutomationProperties.Name="预览下一个文件">
                            <FontIcon Glyph="&#xE76C;" FontSize="20" Style="{StaticResource HubInlineGlyphStyle}" />
                        </Button>
                        <Button x:Name="PreviewZoomResetButton"
                                MinWidth="68"
                                Height="36"
                                Margin="16"
                                Padding="10,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Visibility="Collapsed"
                                Style="{StaticResource HubToolbarButtonStyle}"
                                Click="OnPreviewZoomResetClicked"
                                ToolTipService.ToolTip="恢复为 100%"
                                AutomationProperties.Name="重置图片缩放">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A3;" FontSize="13" Style="{StaticResource HubInlineGlyphStyle}" />
                                <TextBlock x:Name="PreviewZoomLabel" Text="100%" FontSize="11" Style="{StaticResource HubInlineLabelStyle}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Style="{StaticResource HubIconButtonStyle}" Click="OnClosePreviewClicked" ToolTipService.ToolTip="关闭预览">
                            <FontIcon Glyph="&#xE711;" FontSize="14" Style="{StaticResource HubInlineGlyphStyle}" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Background="{StaticResource HubPanelBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewTitle" Margin="16,0,10,0" MaxWidth="220" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="PreviewType" Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource HubTextSecondaryBrush}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="PreviewSize" Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource HubTextSecondaryBrush}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="PreviewPath" Grid.Column="3" Margin="18,0" VerticalAlignment="Center" Foreground="{StaticResource HubTextMutedBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <ToggleButton x:Name="PreviewWrapButton"
                                      Grid.Column="4"
                                      Margin="6,8"
                                      IsChecked="True"
                                      Visibility="Collapsed"
                                      Style="{StaticResource HubPreviewToggleStyle}"
                                      Click="OnPreviewWrapClicked"
                                      AutomationProperties.Name="切换文本自动换行">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8E4;" FontSize="13" Style="{StaticResource HubInlineGlyphStyle}" />
                                <TextBlock x:Name="PreviewWrapLabel" Text="自动换行：开" FontSize="11" Style="{StaticResource HubInlineLabelStyle}" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Grid.Column="5" Margin="6,8,8,8" Style="{StaticResource HubToolbarButtonStyle}" Click="OnOpenSelectedClicked" Content="使用默认应用打开" />
                    </Grid>
                    <ListView x:Name="PreviewFilmstrip"
                              Grid.Row="2"
                              ItemsSource="{x:Bind PreviewItems}"
                              SelectionMode="Single"
                              SelectionChanged="OnPreviewFilmstripSelectionChanged"
                              ItemContainerStyle="{StaticResource HubFilmstripItemStyle}"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ExplorerItemViewModel">
                                <StackPanel Width="142" Margin="3" Spacing="6">
                                    <Border Height="92" Background="{StaticResource HubRaisedBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <Grid>
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" Stretch="UniformToFill" />
                                            <Grid Width="58"
                                                  Height="54"
                                                  Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind IconDescription}"
                                                  IsHitTestVisible="False">
                                                <FontIcon Glyph="{x:Bind IconGlyph}"
                                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                          FontSize="32"
                                                          Foreground="{x:Bind IconBrush}" />
                                                <Border Margin="0,0,0,1"
                                                        Style="{StaticResource HubFileTypeBadgeStyle}"
                                                        BorderBrush="{x:Bind IconBrush}"
                                                        Visibility="{x:Bind IconBadgeVisibility}">
                                                    <TextBlock Text="{x:Bind IconBadgeText}" Foreground="{x:Bind IconBrush}" Style="{StaticResource HubFileTypeBadgeTextStyle}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{x:Bind Name}" FontSize="11" Foreground="{StaticResource HubTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="PreviewShortcutHint" Grid.Row="3" Text="Space  关闭    ·    Esc  退出    ·    ←  →  切换" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource HubTextMutedBrush}" FontSize="11" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Background="#9900050A"
              Visibility="Collapsed"
              Canvas.ZIndex="300">
            <Border Width="680"
                    MaxHeight="790"
                    Margin="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource HubCanvasBrush}"
                    BorderBrush="{StaticResource HubBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="68" />
                    </Grid.RowDefinitions>

                    <Grid Padding="22,0" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Project File Hub 设置" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" />
                            <TextBlock Text="应用偏好与每个项目的工作区记忆" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource HubIconButtonStyle}" Click="OnCloseSettingsClicked" ToolTipService.ToolTip="关闭设置">
                            <FontIcon Glyph="&#xE711;" FontSize="14" Style="{StaticResource HubInlineGlyphStyle}" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="22,18" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="7">
                                <TextBlock Text="浏览与预览" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" />
                                <Border Style="{StaticResource HubSettingsCardStyle}">
                                    <StackPanel Spacing="13">
                                        <ToggleSwitch x:Name="SettingsSpacePreviewSwitch" Header="Space 单文件预览" OnContent="开启" OffContent="关闭" />
                                        <ToggleSwitch x:Name="SettingsInspectorSwitch" Header="显示右侧详细信息" OnContent="显示" OffContent="隐藏" />
                                        <ToggleSwitch x:Name="SettingsFilterRailSwitch" Header="显示文件类型过滤器" OnContent="显示" OffContent="隐藏" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Text="外观" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" />
                                <Border Style="{StaticResource HubSettingsCardStyle}">
                                    <StackPanel Spacing="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="主题" Foreground="{StaticResource HubTextBrush}" />
                                                <TextBlock Text="两种暗色与一种亮色 Focus Canvas 配色" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" />
                                            </StackPanel>
                                            <ComboBox x:Name="SettingsThemePicker" Grid.Column="1" Style="{StaticResource HubCompactComboBoxStyle}">
                                                <ComboBoxItem Content="暗色 · 深夜蓝（默认）" Tag="Midnight" />
                                                <ComboBoxItem Content="暗色 · 石墨黑" Tag="Graphite" />
                                                <ComboBoxItem Content="亮色 · 雾白" Tag="Light" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="界面密度" Foreground="{StaticResource HubTextBrush}" />
                                                <TextBlock Text="调整项目树、过滤栏和详情栏宽度" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" />
                                            </StackPanel>
                                            <ComboBox x:Name="SettingsDensityPicker" Grid.Column="1" Style="{StaticResource HubCompactComboBoxStyle}">
                                                <ComboBoxItem Content="紧凑" Tag="Compact" />
                                                <ComboBoxItem Content="舒适" Tag="Comfortable" />
                                                <ComboBoxItem Content="宽松" Tag="Spacious" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Text="启动与记忆" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" />
                                <Border Style="{StaticResource HubSettingsCardStyle}">
                                    <StackPanel Spacing="13">
                                        <ToggleSwitch x:Name="SettingsRememberWorkspaceSwitch" Header="记住每个项目的工作区" OnContent="记住" OffContent="不记住" />
                                        <TextBlock Margin="0,-8,0,2" Text="保存上次文件夹、筛选类型、排序方式和网格/列表视图。" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="SettingsStartupSwitch" Header="登录 Windows 后自动启动" OnContent="开启" OffContent="关闭" />
                                        <ToggleSwitch x:Name="SettingsTraySwitch" Header="关闭或最小化后继续运行" OnContent="驻留" OffContent="退出" />
                                        <TextBlock Margin="0,-8,0,2" Text="开启后窗口会隐藏到右下角通知区域，后台索引继续工作；完全退出请使用托盘右键菜单。" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Style="{StaticResource HubSettingsCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="通知区域操作" FontWeight="SemiBold" Foreground="{StaticResource HubTextBrush}" />
                                    <TextBlock Text="双击圆形 F 图标恢复窗口；右键可以查看当前项目与索引状态、暂停或恢复后台索引，以及完全退出程序。该功能默认开启。" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Padding="22,0" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsStatusText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" Text="设置保存在本机，不写入项目目录" />
                        <Button Grid.Column="1" Margin="0,0,8,0" Content="取消" Style="{StaticResource HubToolbarButtonStyle}" Click="OnCloseSettingsClicked" />
                        <Button Grid.Column="2" Content="保存设置" Style="{StaticResource HubPrimaryButtonStyle}" Click="OnSaveSettingsClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Background="{StaticResource HubCanvasBrush}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionStatusText" Text="未选择文件" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" VerticalAlignment="Center" />
            <Button x:Name="UndoButton"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Margin="0,0,18,0"
                    Padding="10,4"
                    Style="{StaticResource HubToolbarButtonStyle}"
                    Click="OnUndoClicked">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7A7;" FontSize="13" Style="{StaticResource HubInlineGlyphStyle}" />
                    <TextBlock x:Name="UndoButtonText" Text="撤销" FontSize="11" Style="{StaticResource HubInlineLabelStyle}" />
                </StackPanel>
            </Button>
            <StackPanel x:Name="SpacePreviewHint" Grid.Column="2" Orientation="Horizontal" Spacing="7" Margin="0,0,28,0" VerticalAlignment="Center">
                <Border Padding="6,2" CornerRadius="4" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1"><TextBlock Text="Space" FontSize="10" Foreground="{StaticResource HubTextSecondaryBrush}" /></Border>
                <TextBlock Text="单文件预览" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" Style="{StaticResource HubInlineLabelStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{StaticResource HubSuccessBrush}" />
                <TextBlock Text="本地模式 · MCP 已关闭" FontSize="11" Foreground="{StaticResource HubTextMutedBrush}" Style="{StaticResource HubInlineLabelStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
